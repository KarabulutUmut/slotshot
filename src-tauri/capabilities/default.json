{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "allow-material-preview-enabled",
    "allow-preview-material",
    "allow-capture-region",
    "allow-slot-view",
    "allow-slot-thumbnail",
    "allow-clear-slots",
    "allow-resize-slots",
    "allow-save-slots",
    "allow-configure-exports",
    "allow-drag-slots",
    "core:window:allow-start-dragging"
  ]
}
