{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "allow-capture-region",
    "allow-choose-capture-slot",
    "allow-slot-view",
    "allow-slot-thumbnail",
    "allow-clear-slots",
    "allow-resize-slots",
    "allow-save-slots",
    "allow-configure-exports",
    "allow-drag-slots",
    "core:window:allow-start-dragging",
    "allow-shortcut-view",
    "allow-configure-shortcuts",
    "allow-desktop-view",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-shortcut-recording"
  ]
}
